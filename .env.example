# URL pública del sitio (sin barra final). Se usa en metadata, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://nuvendigital.com

# Envío de emails del formulario de contacto con Resend (https://resend.com).
# Si RESEND_API_KEY está vacío, en desarrollo los mensajes se muestran en la consola.
RESEND_API_KEY=
# Dirección que recibe las solicitudes de presupuesto.
CONTACT_TO_EMAIL=hola@nuvendigital.com
# Remitente verificado en Resend. Mientras no verifiques tu dominio puedes usar onboarding@resend.dev
CONTACT_FROM_EMAIL="Nuven Digital <web@nuvendigital.com>"
