 "lines": [
  {
   "id": "0.0",
   "scene": "gancho",
   "speaker": "pro",
   "start": 0.05,
   "end": 3.16,
   "text": "Abrió hace seis meses y ya me ha quitado clientes."
  },
  {
   "id": "0.1",
   "scene": "gancho",
   "speaker": "pro",
   "start": 3.5,
   "end": 5.54,
   "text": "Yo llevo veinte años en esta calle."
  },
  {
   "id": "1.0",
   "scene": "seva",
   "speaker": "pro",
   "start": 5.84,
   "end": 6.74,
   "text": "No lo entiendo."
  },
  {
   "id": "1.1",
   "scene": "seva",
   "speaker": "pro",
   "start": 6.98,
   "end": 9.72,
   "text": "Mi trabajo es mejor, mis precios son los mismos,"
  },
  {
   "id": "1.2",
   "scene": "seva",
   "speaker": "pro",
   "start": 10.03,
   "end": 12.06,
   "text": "y aun así el cliente se va con el otro."
  },
  {
   "id": "2.0",
   "scene": "busqueda",
   "speaker": "nar",
   "start": 12.57,
   "end": 13.75,
   "text": "La razón es sencilla."
  },
  {
   "id": "2.1",
   "scene": "busqueda",
   "speaker": "nar",
   "start": 14.09,
   "end": 19.17,
   "text": "El cliente no ha visto tus veinte años… te ha buscado en el móvil y no te ha encontrado."
  },
  {
   "id": "3.0",
   "scene": "ficha",
   "speaker": "nar",
   "start": 19.55,
   "end": 20.33,
   "text": "Al otro sí."
  },
  {
   "id": "3.1",
   "scene": "ficha",
   "speaker": "nar",
   "start": 20.65,
   "end": 23.99,
   "text": "Con sus fotos, sus reseñas y un botón para reservar."
  },
  {
   "id": "4.0",
   "scene": "informatica",
   "speaker": "pro",
   "start": 24.36,
   "end": 26.41,
   "text": "Pero yo de informática no sé nada."
  },
  {
   "id": "5.0",
   "scene": "web",
   "speaker": "nar",
   "start": 26.75,
   "end": 27.49,
   "text": "No hace falta."
  },
  {
   "id": "5.1",
   "scene": "web",
   "speaker": "nar",
   "start": 27.8,
   "end": 33.04,
   "text": "Una web con tu trabajo, tus opiniones y tu teléfono, para que te vean antes de llamar al otro."
  },
  {
   "id": "6.0",
   "scene": "marca",
   "speaker": "pro",
   "start": 33.44,
   "end": 34.43,
   "text": "¿Y quién me la hace?"
  },
  {
   "id": "6.1",
   "scene": "marca",
   "speaker": "nar",
   "start": 34.84,
   "end": 35.83,
   "text": "Nuven Digital."
  },
  {
   "id": "7.0",
   "scene": "valores",
   "speaker": "nar",
   "start": 36.13,
   "end": 40.59,
   "text": "Webs a medida, rápidas, pensadas para que te encuentren… y te llamen."
  },
  {
   "id": "8.0",
   "scene": "cierre",
   "speaker": "nar",
   "start": 40.91,
   "end": 43.44,
   "text": "Veinte años de oficio merecen ser vistos."
  },
  {
   "id": "8.1",
   "scene": "cierre",
   "speaker": "nar",
   "start": 43.76,
   "end": 45.81,
   "text": "Escríbenos y hablamos de tu proyecto."
  }
 ],
